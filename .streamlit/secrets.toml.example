# Copy this file to .streamlit/secrets.toml locally (never commit the real
# file — it's already excluded via .gitignore), and set the same keys in
# Streamlit Cloud's "Secrets" panel for the deployed app.

# Shared password for the app's login gate (auth_gate.py). Pick anything —
# there are no individual user accounts, just one shared password.
APP_PASSWORD = "change-me"

# Zoho self-client OAuth credentials (api-console.zoho.eu, EU data center).
# See README.md for how to generate these — in short:
#   1. Create a Self Client at https://api-console.zoho.eu
#   2. Generate Code with scopes: ZohoCRM.coql.READ, ZohoCRM.modules.contacts.READ,
#      ZohoCRM.modules.leads.READ, ZohoCRM.modules.accounts.READ,
#      ZohoCRM.modules.emails.READ
#   3. Exchange the grant code once for an access + refresh token
#   4. Paste the refresh token below — it's long-lived and is what this app
#      actually runs on day to day.
ZOHO_CLIENT_ID = "your-client-id"
ZOHO_CLIENT_SECRET = "your-client-secret"
ZOHO_REFRESH_TOKEN = "your-refresh-token"
